# Copy to .env.local (git-ignored) and fill in. See AGENTS.md → Environment variables.

# Client (exposed to the browser via Vite)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Netlify functions only (set in Netlify env for production; `netlify dev` reads them locally)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SUPABASE_SERVICE_KEY=
